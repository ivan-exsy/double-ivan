{
  "narration_path": "d:\\Coding\\double-ivan\\video\\l-talk\\audio\\narration.mp3",
  "total_sec": 82.07,
  "segments": [
    {
      "index": 0,
      "content": "What if... you had a second chance to make it right?",
      "start_sec": 0.2,
      "end_sec": 5.08
    },
    {
      "index": 1,
      "content": "What if you could practice that hard conversation — before it ever happened?",
      "start_sec": 5.23,
      "end_sec": 10.11
    },
    {
      "index": 2,
      "content": "What if you had a Double?",
      "start_sec": 10.26,
      "end_sec": 11.54
    },
    {
      "index": 3,
      "content": "An AI version of you.",
      "start_sec": 11.69,
      "end_sec": 13.61
    },
    {
      "index": 4,
      "content": "Talking like you.",
      "start_sec": 13.71,
      "end_sec": 14.67
    },
    {
      "index": 5,
      "content": "Reacting like you.",
      "start_sec": 14.77,
      "end_sec": 16.13
    },
    {
      "index": 6,
      "content": "Making choices like you.",
      "start_sec": 16.23,
      "end_sec": 18.07
    },
    {
      "index": 7,
      "content": "In Doubland, you build an AI Double from your personality.",
      "start_sec": 18.22,
      "end_sec": 22.54
    },
    {
      "index": 8,
      "content": "Then you watch it live, in a world with other Doubles.",
      "start_sec": 22.69,
      "end_sec": 26.61
    },
    {
      "index": 9,
      "content": "Every conversation.",
      "start_sec": 26.71,
      "end_sec": 28.07
    },
    {
      "index": 10,
      "content": "Every choice.",
      "start_sec": 28.17,
      "end_sec": 29.37
    },
    {
      "index": 11,
      "content": "Every relationship.",
      "start_sec": 29.47,
      "end_sec": 30.99
    },
    {
      "index": 12,
      "content": "This season: L-Talks.",
      "start_sec": 31.19,
      "end_sec": 33.27
    },
    {
      "index": 13,
      "content": "A three-hundred-member alumni chat group.",
      "start_sec": 33.37,
      "end_sec": 36.09
    },
    {
      "index": 14,
      "content": "We analyzed a year of conversations.",
      "start_sec": 36.24,
      "end_sec": 38.96
    },
    {
      "index": 15,
      "content": "Found fifteen most active voices.",
      "start_sec": 39.06,
      "end_sec": 41.7
    },
    {
      "index": 16,
      "content": "Built their Doubles from what they said — no surveys, no interviews.",
      "start_sec": 41.8,
      "end_sec": 47.08
    },
    {
      "index": 17,
      "content": "Dropped them into Doubland.",
      "start_sec": 47.18,
      "end_sec": 48.78
    },
    {
      "index": 18,
      "content": "And pressed play.",
      "start_sec": 48.93,
      "end_sec": 51.49
    },
    {
      "index": 19,
      "content": "Fifteen Doubles.",
      "start_sec": 51.69,
      "end_sec": 53.13
    },
    {
      "index": 20,
      "content": "AI version of real people.",
      "start_sec": 53.23,
      "end_sec": 55.39
    },
    {
      "index": 21,
      "content": "No one at the keyboard.",
      "start_sec": 55.49,
      "end_sec": 56.85
    },
    {
      "index": 22,
      "content": "We wanted to keep it interesting — so we made it hard for them.",
      "start_sec": 57.05,
      "end_sec": 61.21
    },
    {
      "index": 23,
      "content": "Survival Mode.",
      "start_sec": 61.36,
      "end_sec": 62.48
    },
    {
      "index": 24,
      "content": "Every day, one Double gets eliminated — until only one remains.",
      "start_sec": 62.58,
      "end_sec": 68.1
    },
    {
      "index": 25,
      "content": "Watch live 24/7.",
      "start_sec": 68.25,
      "end_sec": 70.01
    },
    {
      "index": 26,
      "content": "Follow any Double.",
      "start_sec": 70.11,
      "end_sec": 71.47
    },
    {
      "index": 27,
      "content": "See how people change under pressure.",
      "start_sec": 71.62,
      "end_sec": 74.1
    },
    {
      "index": 28,
      "content": "It's just like real life.",
      "start_sec": 74.3,
      "end_sec": 76.06
    },
    {
      "index": 29,
      "content": "They surprise you.",
      "start_sec": 76.16,
      "end_sec": 77.2
    },
    {
      "index": 30,
      "content": "And after a while... you ask — what would MY Double do?",
      "start_sec": 77.35,
      "end_sec": 82.07
    }
  ]
}