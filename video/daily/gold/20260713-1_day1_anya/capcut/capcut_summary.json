  "text_full_sequence": [
    {
      "start_s": 0.9,
      "end_s": 1.9,
      "text": "THESE ARE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 2.8,
      "end_s": 4.3,
      "text": "AI VERSIONS OF",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 4.3,
      "end_s": 5.4,
      "text": "REAL PEOPLE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 5.4,
      "end_s": 6.9,
      "text": "MAKING CHOICES",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 6.9,
      "end_s": 7.6,
      "text": "NO ONE WROTE FOR THEM",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 7.6,
      "end_s": 9.033,
      "text": "WROTE FOR THEM",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 9.133,
      "end_s": 10.5,
      "text": "FIFTEEN OF THEM ENTERED",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 12.3,
      "end_s": 12.767,
      "text": "SOMEONE IS VOTED OUT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 12.767,
      "end_s": 13.8,
      "text": "IS VOTED OUT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 13.8,
      "end_s": 14.833,
      "text": "EVERY NIGHT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 14.833,
      "end_s": 16.367,
      "text": "UNTIL ONE REMAINS",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 16.467,
      "end_s": 18.033,
      "text": "TODAY WE'RE FOLLOWING",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 20.3,
      "end_s": 22.1,
      "text": "IRENE GOES HARD FOR COVER",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 23.567,
      "end_s": 25.067,
      "text": "IVAN WATCHES PEOPLE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 25.067,
      "end_s": 26.167,
      "text": "BEFORE HE BETS",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 29.433,
      "end_s": 30.633,
      "text": "AT 11:00AM",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 30.633,
      "end_s": 32.933,
      "text": "A DAILY CHALLENGE BEGINS",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 34.767,
      "end_s": 37.533,
      "text": "EACH DOUBLE GETS A SECRET CARD",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 37.667,
      "end_s": 39.433,
      "text": "HOLD TO STAY IN THE FIGHT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 39.433,
      "end_s": 41.267,
      "text": "OR FOLD AND SIT OUT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 41.633,
      "end_s": 43.0,
      "text": "HIGHEST CARD REMAINING",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 43.0,
      "end_s": 44.267,
      "text": "WINS THE SHIELD",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 44.467,
      "end_s": 44.767,
      "text": "AND IMMUNITY",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 44.767,
      "end_s": 46.467,
      "text": "FROM TONIGHT'S VOTE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 46.467,
      "end_s": 48.533,
      "text": "IRENE GOT THE HIGHEST CARD",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 48.933,
      "end_s": 50.3,
      "text": "SHE WINS THE SHIELD",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 50.3,
      "end_s": 51.7,
      "text": "AND IS SAFE TONIGHT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 51.7,
      "end_s": 53.3,
      "text": "AS THE DAY CONTINUES",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 58.567,
      "end_s": 59.767,
      "text": "AT THE END OF THE DAY",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 59.767,
      "end_s": 62.067,
      "text": "EVERY DOUBLE CASTS A BALLOT",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 62.233,
      "end_s": 64.4,
      "text": "TONIGHT SIX VOTES LAND ON",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 64.4,
      "end_s": 65.433,
      "text": "IVAN PITS",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 65.9,
      "end_s": 68.0,
      "text": "IRENE'S BALLOT IS ONE OF THEM",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 68.5,
      "end_s": 71.0,
      "text": "IVAN IS GONE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 73.033,
      "end_s": 74.067,
      "text": "TOMORROW",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 74.067,
      "end_s": 75.833,
      "text": "THE SHIELD IS GONE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 75.833,
      "end_s": 78.033,
      "text": "NEW ALLIANCES WILL FORM",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 78.3,
      "end_s": 79.7,
      "text": "NEW TARGETS WILL EMERGE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 80.233,
      "end_s": 81.4,
      "text": "AND ANOTHER DOUBLE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 81.4,
      "end_s": 82.9,
      "text": "WILL LEAVE THE GAME",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 82.9,
      "end_s": 84.467,
      "text": "WATCH EVERY CONVERSATION",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 84.467,
      "end_s": 85.333,
      "text": "CHALLENGE",
      "template": "向上渐显 微发光"
    },
    {
      "start_s": 85.333,
      "end_s": 86.167,
